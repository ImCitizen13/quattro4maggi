{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "types": ["@webgpu/types", "node"],
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": ["node_modules", "plugins"]
}

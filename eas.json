{
  "cli": {
    "version": ">= 16.32.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "APP_ENV": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "preview"
      }
    },
    "testflight": {
      "autoIncrement": true,
      "channel": "testflight",
      "env": {
        "APP_ENV": "production"
      }
    },
    "testflight_1.0.0": {
      "autoIncrement": true,
      "channel": "testflight_1.0.0",
      "env": {
        "APP_ENV": "production"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "APP_ENV": "production"
      }
    }
  },
  "submit": {
    "production": {},
    "testflight": {},
    "testflight_1.0.0": {}
  }
}
